# Единый env серверного стека (docker compose --env-file).
# Одноразовый бутстрап: скопировать в <DEPLOYMENT_FOLDER>/.env на сервере
# и заполнить. Дальше CI обновляет в нём ТОЛЬКО IMAGE_TAG.
# Preflight деплоя упадёт, если файла нет, остались CHANGE_ME
# или отсутствует какая-то из переменных ниже.

# Имя compose-проекта (префикс контейнеров и томов на сервере)
PROJECT_NAME=seo-cp-generator

# Порт приложения на 127.0.0.1 хоста; наружу проксирует веб-сервер (ispmanager/nginx)
PORT_APP=3000

# Postgres (контейнер database; порт наружу не публикуется).
# Данные — в docker-томе <PROJECT_NAME>_pgdata, деплой их не трогает.
DB_DATABASE=seocp
DB_PASSWORD=CHANGE_ME

# Docker-образы: репозиторий в GHCR и тег (CI подставляет sha коммита при каждом деплое)
IMAGE_REPO=ghcr.io/qmedia-by/seo-cp-generator
IMAGE_TAG=latest
